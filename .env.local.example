# Google Analytics 4
# Get your Measurement ID from: https://analytics.google.com → Admin → Data Streams → Web
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend — newsletter signup + contact form
# 1. Get an API key at https://resend.com/api-keys (server-only, do NOT prefix with NEXT_PUBLIC_)
# 2. Optional: create an audience and copy its ID from https://resend.com/audiences
# 3. Optional: override the From address (must be from a verified domain)
# 4. Optional: override where contact form / newsletter admin notifications are delivered (default pt.rubby@gmail.com)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=Patrik Přikryl <newsletter@patrikprikryl.com>
CONTACT_TO_EMAIL=pt.rubby@gmail.com
NEWSLETTER_ADMIN_EMAIL=pt.rubby@gmail.com

# Welcome series (lib/welcome-series.js — see docs/NEWSLETTER_STRATEGY.md)
# 5. Set to "on" to auto-schedule the 2 follow-up emails on each new signup.
#    Keep OFF until the From domain is verified and delivery is tested — the immediate
#    welcome email already covers the basics on its own.
NEWSLETTER_WELCOME_SERIES=off
# 6. Optional shared secret for the manual test trigger POST /api/newsletter/welcome-series
#    (send via header `x-admin-secret` or JSON body `secret`). Blank = manual route disabled.
NEWSLETTER_ADMIN_SECRET=

# Auto-digest on new blog post (scripts/send-blog-digest.js, run by
# .github/workflows/blog-digest.yml — see docs/NEWSLETTER_SETUP.md §7).
# These belong in GitHub Actions Secrets/Variables, not Vercel — the digest runs in CI,
# not in the app. Listed here so the full env surface lives in one place.
# 7. Master switch. Keep "off" until the From domain is verified — nothing sends otherwise.
BLOG_DIGEST_ENABLED=off
# 8. Per-locale audiences (preferred): cs posts → CS list, en → EN, de → DE. If unset, the
#    script falls back to the single RESEND_AUDIENCE_ID and sends one digest per article in
#    BLOG_DIGEST_PRIMARY_LOCALE (default "en").
RESEND_AUDIENCE_ID_CS=
RESEND_AUDIENCE_ID_EN=
RESEND_AUDIENCE_ID_DE=
BLOG_DIGEST_PRIMARY_LOCALE=en
# 9. Optional: where replies land (default = the From address).
RESEND_REPLY_TO=
